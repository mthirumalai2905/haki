DATABASE_URL="file:./dev.db"

# Hermes uses DeepSeek as its reasoning model. Keep this server-side only.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# Resend for campaign email. Server only. Do not send until you flip this on.
RESEND_API_KEY=
RESEND_FROM=
RESEND_SEND_ENABLED=false
